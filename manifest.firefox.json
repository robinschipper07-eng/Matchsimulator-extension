{
  "manifest_version": 3,
  "name": "Match Simulator Club Logos (private)",
  "version": "2.1",
  "description": "Adds real-life club logos and nation flags on matchsimulator.com. For personal use.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://en.wikipedia.org/*",
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://www.thesportsdb.com/*",
    "https://r2.thesportsdb.com/*",
    "https://fminside.net/*",
    "https://img.fminside.net/*",
    "https://thumb.wikimedia.org/*",
    "https://www.wikidata.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://matchsimulator.com/*",
        "https://www.matchsimulator.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "club-logos@matchsimulator.private",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}